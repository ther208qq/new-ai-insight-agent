# 复制本文件为 .env 再填值。.env 不会被提交（见 .gitignore）。
#
# 任何说 OpenAI /chat/completions 这一套的服务都能接，
# 换一家只改下面这几个值，不用动代码。

# 必填：服务商的 API Key
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# 必填：模型名，例如 deepseek-chat / qwen-plus / gpt-4o-mini
LLM_MODEL=deepseek-chat

# 选填：服务商的接口地址。留空则用 openai 包的默认值（api.openai.com/v1）。
# DeepSeek   https://api.deepseek.com/v1
# 通义千问   https://dashscope.aliyuncs.com/compatible-mode/v1
# Moonshot   https://api.moonshot.cn/v1
# 本地 Ollama http://localhost:11434/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 选填：以下是默认值，一般不用改
LLM_TIMEOUT=60
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0


# 选填：日志级别 DEBUG / INFO / WARNING / ERROR / CRITICAL，默认 INFO。
#
# 日志记的是「一次运行发生了什么」：每轮决策选了什么 Tool、为什么停、反思判 pass
# 还是 retry、走到第几轮、LLM 客户端降到了哪一档、Context 在哪被截断。写给人读的，
# 输出到 stderr —— stdout 留给 main.py 那份正式报告，所以
# `python main.py > out.txt` 只拿得到报告，日志不会混进去。
#
# 只想看异常与降级填 WARNING，完全静音填 CRITICAL（本项目不打 CRITICAL）。
#
# 变量名带 ai_insight_ 前缀：LOG_LEVEL 太通用，部署平台的环境里可能已经有一个
# 同名但管着别的东西的变量，而真实环境变量优先于本文件。
AI_INSIGHT_LOG_LEVEL=INFO
