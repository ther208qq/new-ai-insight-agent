# 复制本文件为 .env 再填值。.env 不会被提交（见 .gitignore）。
#
# 任何说 OpenAI /chat/completions 这一套的服务都能接，
# 换一家只改下面这几个值，不用动代码。

# 必填：服务商的 API Key
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# 必填：模型名，例如 deepseek-chat / qwen-plus / gpt-4o-mini
LLM_MODEL=deepseek-chat

# 选填：服务商的接口地址。留空则用 openai 包的默认值（api.openai.com/v1）。
# DeepSeek   https://api.deepseek.com/v1
# 通义千问   https://dashscope.aliyuncs.com/compatible-mode/v1
# Moonshot   https://api.moonshot.cn/v1
# 本地 Ollama http://localhost:11434/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 选填：以下是默认值，一般不用改
LLM_TIMEOUT=60
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0
